script. 
  document.querySelectorAll('.tarjeta').forEach(tarjeta => {
    tarjeta.addEventListener('click', () => {    
      //Ejecución de la ventana Modal
      const modal = document.querySelector('.info');
      modal.style.display = "flex";

      // Si ya existe un mapa, lo eliminamos para reiniciar
      if (mapa) {
        mapa.remove();
      }

      // Inicializar mapa
      var mapa = L.map('mapa').setView([-34.6037, -58.3816], 13);
    
      // Capa base (OpenStreetMap)
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
      }).addTo(mapa);

      // Dibujar un círculo en lugar de un marcador
      L.circle([-34.6037, -58.3816], {
        radius: 1000, // radio en metros (ejemplo: 1000m ≈ 1km)
        color: 'blue',
        fillColor: '#3f83f8',
        fillOpacity: 0.3
      }).addTo(mapa)
        .bindPopup('Región aproximada')
        .openPopup();
      
    });
  });

  document.getElementById("btn-cerrar").addEventListener('click', () => {
    document.querySelector('.info').style.display = "none";
  });