doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    title UBIKA
    link(rel="stylesheet", href="css/style.css")
    link(rel="stylesheet", href="https://unpkg.com/leaflet/dist/leaflet.css")
    
  body
    header.header
      h1 UBIKA 
      p Todo en un solo lugar

    // Barra de menú horizontal
    nav.menu
      ul
        li.busqueda
          form(action="/buscar" method="get")
            input(type="text" name="q" placeholder="Buscar...")
            button(type="submit") 🔍
            i.fa-solid.fa-search
        li.iconos
          a#usuario(href="#perfil") 👤
          a(href="#mensajes") 📩
          a(href="#favoritos") ❤️
          a(href="#notificaciones") 🔔

    .contenedor
      .tarjeta#tarjeta1
        .imagen-container
          img(src="img/victor1.jpg" alt="Consultoría Empresarial")
          button.favorito ♥
        .contenido
          h3 Desarrollo Web
            span.puntuacion 4.5 
            span.estrella ★
          p Optimización de procesos y estrategia.       

      .tarjeta#tarjeta2
        .contenido
          h3 Gestión de RRHH
          p Selección, Capacitación y Administración de Personal.

      .tarjeta#tarjeta3
        .contenido
          h3 Marketing Digital
          p Potencia tu Negocio       

    // Modal global (fuera de las tarjetas)
    .info
      .modal-superior
        .seccion-izquierda
          #mapa(style="height:100%; width:100%")
        .seccion-derecha
          h4 Información
          p CABA
          p Información adicional aquí
      .comentarios Comentarios
      .modal-inferior
        .comentario
          span.puntos 
          p Aquí irán los comentarios con sus puntuaciones
        .comentario
          span.puntos 
          p Aquí irán los comentarios con sus puntuaciones
        .comentario
          span.puntos ★★★
          p Aquí irán los comentarios con sus puntuaciones
        .comentario
          span.puntos ★★★★
          p Aquí irán los comentarios con sus puntuaciones
        .comentario
          span.puntos ★★★★★
          p Aquí irán los comentarios con sus puntuaciones
      .botones
        button#contactar Contactar
        button#btn-cerrar-info Cerrar

    //Modal con dos pestañas
    .modal
      .modal-contenido
        button#x.btn-cerrar(type="button") x
        // Pestañas
        .modal-tabs
        button.tab(type="button" data-tab="registro") Registrarse
        button.tab.activa(type="button" data-tab="ingreso") Ingresar
        // REGISTRO
        .contenido-tab#registro
          h2 Crear cuenta
          .form
            form
              label Nombre
              input(type="text" name="nombre" placeholder="Nombre")
              label Apellido
              input(type="text" name="apellido" placeholder="Apellido")
              label Preferencia de contacto
              select(name="contacto" placeholder="Seleccionar")
                option(value="" disabled selected) Seleccione una opción 
                option(value="email") Correo
                option(value="whatsapp") WhatsApp
              label Contacto
              input(type="text" name="contacto" placeholder="contacto según opción seleccionada")
              label Contraseña
              input(type="password" name="password")
              .aceptar
                input#check-aceptar(type="checkbox" name="comunicaciones")
                p Deseo recibir comunicaciones
              button.btn-principal(type="submit" name= "boton" value= "registrar") Registrarme
        // INGRESO
        .contenido-tab.activo#ingreso
          h2 Ingresar
          .form
            form(method="post" action="/new-entry")
              label Contacto
              input(type="text" name="nombre" placeholder="Contacto Ingresado")
              label Contraseña
              input(type="password" name="password")
              button.btn-principal(type="submit" name= "boton" value= "ingresar") Ingresar
              button.btn-principal(type="submit" name= "boton" value= "olvide") Olvide mi Contraseña
        
        .ventana(name="error" open=mostrar)
          h1 Debe completar los datos, son obligatorio
          a(href="/")
            button.boton-nook(name="boton" value="cerrar") Cerrar

      
    footer.footer
      p &copy; 2026 Servicios Profesionales | Todos los derechos reservados

    script(type="module" src="/funciones_rutas/inicio.js")
    script(src="https://unpkg.com/leaflet/dist/leaflet.js")
